---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  messages: Record<string, any>;
  jsonLd?: any;
  canonicalOverride?: string;
  noindex?: boolean;
  alternates?: { hreflang: string; href: string }[];
}
const { lang, title, description, messages, jsonLd: customJsonLd, canonicalOverride, noindex, alternates } = Astro.props;
const canonical = canonicalOverride ?? `${siteConfig.domain}/${lang}/`;

const faqs = (messages && messages.guide && messages.guide.faqs) ? messages.guide.faqs : [];

const alternateNames = Array.from(
  new Set(
    Object.values(siteConfig.name).concat([
      'Bang Pa-In Royal Palace',
      'พระราชวังบางปะอิน',
      'Summer Palace',
      '邦芭茵夏宫',
      '邦巴因王宫',
    ]),
  ),
).filter((v, i, arr) => v !== siteConfig.name[lang] && arr.indexOf(v) === i);

const defaultJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristAttraction',
    '@id': `${siteConfig.domain}/#tourist-attraction`,
    name: siteConfig.name[lang],
    alternateName: alternateNames,
    description,
    image: `${siteConfig.domain}/gallery/bang-pa-in-palace-1.jpg`,
    url: canonical,
    telephone: siteConfig.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Ban Len, Bang Pa-in District',
      addressLocality: 'Phra Nakhon Si Ayutthaya',
      postalCode: '13160',
      addressCountry: 'TH',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    hasMap: siteConfig.mapsUrl,
    isAccessibleForFree: false,
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '08:00',
        closes: '16:00',
      },
    ],
    sameAs: Array.from(new Set([
      ...siteConfig.sameAs,
      'https://www.tourismthailand.org/Attraction/bang-pa-in-palace',
    ])),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const jsonLd = customJsonLd ?? defaultJsonLd;

const hreflangLinks = alternates ?? [
  ...languagesList.map((l) => ({ hreflang: htmlLang[l], href: `${siteConfig.domain}/${l}/` })),
  { hreflang: 'x-default', href: `${siteConfig.domain}/th/` },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`/gallery/bang-pa-in-palace-1.jpg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}/gallery/bang-pa-in-palace-1.jpg`} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    {hreflangLinks.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain">
    <slot />
  </body>
</html>

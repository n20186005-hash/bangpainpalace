---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../config';
import { getI18n, type Lang } from '../../../i18n/ui';
import { expandedGuides } from '../../../data/expandedGuides';
import { zhGuides, thGuides } from '../../../data/guideTranslations';
import { guidePlaces, guideMapUrl, palaceImages } from '../../../data/guidePlaces';

export const prerender = true;
export function getStaticPaths() {
  return (['zh', 'th'] as const).flatMap(lang => expandedGuides.map(([slug]) => ({ params: { lang, slug }, props: { lang, slug } })));
}
const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const t = (lang === 'zh' ? zhGuides : thGuides)[slug];
if (!t) throw new Error(`Missing ${lang} editorial translation: ${slug}`);
const [title, tagline, introduction, highlights, route, photo] = t;
const chinese = lang === 'zh';
const place = guidePlaces[slug];
const subject = place?.name ?? 'Bang Pa-In Royal Palace';
const area = place?.area ?? 'Bang Pa-in, Phra Nakhon Si Ayutthaya, Thailand';
const mapUrl = place ? guideMapUrl(subject, area) : siteConfig.mapsUrl;
const images = place ? [...place.images.map(n => `/gallery/bang-pa-in-palace-${n}.jpg`), ...(place.externalImages ?? [])] : palaceImages.slice((expandedGuides.findIndex(g => g[0] === slug) % 9), (expandedGuides.findIndex(g => g[0] === slug) % 9) + 3).map(n => `/gallery/bang-pa-in-palace-${n}.jpg`);
const away = ['wat-niwet-thammaprawat','ayutthaya-historical-park','wat-chaiwatthanaram','wat-mahathat'].includes(slug);
const rail = slug === 'bang-pa-in-railway-station';
const management = chinese ? (rail ? '邦芭茵火车站属于泰国铁路交通系统，由铁路工作人员负责站台与列车运行管理，与皇家行宫管理范围不同。' : away ? (slug === 'wat-niwet-thammaprawat' ? '尼威塔玛帕瓦寺是一座仍在使用的佛教皇家寺院，寺院人员负责宗教活动与参访秩序；它不属于夏宫园区。' : '这处大城古迹由泰国文化遗产主管机构及现场人员负责保护和管理，并非邦芭茵皇家行宫的一部分。') : '邦芭茵皇家行宫属于与泰国王室有关的皇家场所。园区管理人员负责游客动线，部分建筑可能因皇家活动或保育工程而限制参观。') : (rail ? 'สถานีรถไฟบางปะอินอยู่ในระบบรถไฟไทย เจ้าหน้าที่รถไฟดูแลชานชาลาและการเดินรถ ไม่ได้อยู่ในพื้นที่บริหารของพระราชวัง' : away ? (slug === 'wat-niwet-thammaprawat' ? 'วัดนิเวศธรรมประวัติเป็นวัดพุทธที่ยังประกอบศาสนกิจ บุคลากรวัดดูแลพื้นที่และมารยาทผู้มาเยือน วัดแยกจากเขตพระราชวัง' : 'โบราณสถานแห่งนี้อยู่ภายใต้การดูแลอนุรักษ์ของหน่วยงานมรดกวัฒนธรรมไทยและเจ้าหน้าที่พื้นที่ ไม่ใช่ส่วนที่พระราชวังบางปะอินบริหาร') : 'พระราชวังบางปะอินเป็นพื้นที่หลวงที่เกี่ยวข้องกับสำนักพระราชวัง เจ้าหน้าที่กำหนดทางเข้าชมและอาจจำกัดบางอาคารในช่วงพระราชพิธีหรือการอนุรักษ์');
const ui = chinese ? {
  home:'邦芭茵夏宫',guides:'游览指南',eyebrow:'大城府 · 景点实用指南',map:'在 Google 地图查看地点',entry:'核实入场信息',about:'关于',views:'实景照片',image:'该地点的参观照片',notice:'值得观察的细节',history:'历史背景',tip:'拍摄与参观建议',story:'深入了解',storyNote:'请把历史背景与实际建筑细节结合起来观察。放慢脚步，阅读现场说明牌，往往能发现更有价值的细节。',info:'基本游览信息',destination:'景点名称',location:'所在地',navigation:'查看位置与导航',hours:'门票与开放',hoursText:'门票价格、入场限制及开放时间可能改变，请参考官方旅游资讯并在现场确认。',dress:'着装',dressText:'尊重对应地点的着装要求与现场标示；皇家及宗教场所可能有更严格的规定。',transport:'交通方式',transportText:'可从曼谷或大城乘车前往邦芭茵，也可乘火车到邦芭茵站后转当地交通。',transportLink:'查看交通指南',walk:'建议步行路线',step1:'先阅读入口公告，确认可通行路线和临时关闭区域。',step3:'停下观察上述建筑与园林细节。',step4:'沿允许通行的路线返回，并为后续交通预留时间。',before:'出发前须知',beforeText:'预留休息时间并随身携带饮水。对于限制进入的室内空间与仪式场所，请遵从工作人员指示。导航请使用本页专属地点的地图链接。',faq:'常见问答',q1:`可以自行参观 ${subject} 吗？`,a1:`请依照 ${subject} 的实际开放安排游览。皇家建筑、佛教寺院与受保护古迹的规则不同，应以现场公告和工作人员指示为准。`,q2:'参观需要准备什么？',a2:'建议穿舒适的步行鞋，携带饮水、遮阳或雨具，并提前保存地图；注意现场着装与摄影规定。',q3:`${subject} 在哪里？`,a3:`地点位于 ${area}。请使用本页对应名称的 Google 地图搜索链接，并在导航前核对地点名称。`,sources:'资料来源与延伸阅读',sourceText:'历史背景与景点介绍参考：',sourceNote:'开放条件请在出行前再次核实。',imageSource:'地点照片参考：',photoLink:'对应地点的公开照片资料',railPhoto:'邦芭茵车站亭阁照片（旅行者分享）',mapHeading:'位置与交通地图',mapText:`在 ${area} 查找 ${subject} 的正确入口；附近大城景点需另外安排交通。`,go:'导航前往',more:'继续探索',overview:'夏宫概览',architecture:'建筑指南',nearby:'附近景点',photography:'摄影指南',emptyTitle:'探索这个地点',emptyText:'此地点与夏宫为不同参访站点，请使用专属地图结果核对位置及近期现场照片。',emptyLink:'查看地图与照片',caption:'对应地点的参访实景',description:'历史、建筑、步行路线与实用旅行建议。'
} : {
  home:'พระราชวังบางปะอิน',guides:'คู่มือเที่ยว',eyebrow:'อยุธยา · คู่มือสถานที่ท่องเที่ยว',map:'ดูสถานที่ใน Google Maps',entry:'ตรวจสอบข้อมูลเข้าชม',about:'เกี่ยวกับ',views:'ภาพสถานที่',image:'ภาพถ่ายสถานที่',notice:'จุดที่ควรสังเกต',history:'ประวัติความเป็นมา',tip:'เคล็ดลับถ่ายภาพและเที่ยวชม',story:'เรียนรู้เรื่องราวเพิ่มเติม',storyNote:'ลองเปรียบเทียบบทบาททางประวัติศาสตร์กับรายละเอียดของอาคารจริง ใช้เวลาสังเกตและอ่านป้ายคำอธิบายในพื้นที่',info:'ข้อมูลสำคัญสำหรับผู้มาเยือน',destination:'สถานที่',location:'ที่ตั้ง',navigation:'ดูตำแหน่งและนำทาง',hours:'บัตรเข้าและเวลาเปิด',hoursText:'ราคา ข้อกำหนด และเวลาเปิดอาจเปลี่ยนได้ ควรตรวจสอบข้อมูลท่องเที่ยวทางการและยืนยันกับเจ้าหน้าที่ในวันเดินทาง',dress:'การแต่งกาย',dressText:'ปฏิบัติตามกฎแต่งกายของสถานที่และป้ายประกาศ โดยเฉพาะพื้นที่หลวงและศาสนสถาน',transport:'การเดินทาง',transportText:'เดินทางโดยรถจากกรุงเทพฯ หรืออยุธยา หรือขึ้นรถไฟไปสถานีบางปะอินแล้วต่อรถท้องถิ่น',transportLink:'ดูคู่มือเดินทาง',walk:'แผนเดินเที่ยวแบบง่าย',step1:'อ่านประกาศทางเข้า ตรวจสอบเส้นทางเปิดและพื้นที่ปิดชั่วคราว',step3:'หยุดสังเกตรายละเอียดสถาปัตยกรรมและสวนตามคำแนะนำด้านบน',step4:'เดินกลับตามทางที่อนุญาตและเผื่อเวลาสำหรับรถเที่ยวต่อ',before:'ข้อควรรู้ก่อนเดินทาง',beforeText:'เผื่อเวลาพักในร่ม เตรียมน้ำดื่ม และปฏิบัติตามคำแนะนำเจ้าหน้าที่เรื่องห้องหรือพื้นที่ประกอบพิธีที่จำกัดการเข้า ใช้ลิงก์แผนที่ของสถานที่นี้โดยเฉพาะ',faq:'คำถามที่พบบ่อย',q1:`สามารถเที่ยว ${subject} ด้วยตนเองได้ไหม?`,a1:`วางแผนตามเงื่อนไขการเปิดของ ${subject} พระราชวัง วัด และโบราณสถานมีกฎต่างกัน กรุณาดูป้ายและคำแนะนำเจ้าหน้าที่`,q2:'ควรเตรียมอะไรไปบ้าง?',a2:'รองเท้าเดินสบาย น้ำดื่ม อุปกรณ์กันแดดหรือฝน และแผนที่ที่บันทึกไว้ ควรเคารพข้อกำหนดการแต่งกายและถ่ายภาพ',q3:`${subject} อยู่ที่ไหน?`,a3:`สถานที่อยู่ใน ${area} ใช้ลิงก์ค้นหา Google Maps เฉพาะจุดจากหน้านี้ และตรวจสอบชื่อก่อนนำทาง`,sources:'แหล่งข้อมูลและอ่านเพิ่มเติม',sourceText:'ประวัติและข้อมูลสถานที่อ้างอิงจาก:',sourceNote:'ตรวจสอบการเปิดเข้าชมใกล้วันเดินทางอีกครั้ง',imageSource:'แหล่งภาพสถานที่:',photoLink:'ภาพสาธารณะของสถานที่นี้',railPhoto:'ภาพพลับพลาสถานีบางปะอิน (ผู้เดินทางแบ่งปัน)',mapHeading:'แผนที่และการเดินทาง',mapText:`ตรวจสอบทางเข้าของ ${subject} ใน ${area} หากจะเที่ยวอยุธยาจุดอื่นต้องจัดการเดินทางแยก`,go:'นำทางไป',more:'เที่ยวต่อ',overview:'ภาพรวมพระราชวัง',architecture:'คู่มือสถาปัตยกรรม',nearby:'สถานที่ใกล้เคียง',photography:'คู่มือถ่ายภาพ',emptyTitle:'สำรวจสถานที่นี้',emptyText:'จุดนี้เป็นสถานที่แยกจากพระราชวัง กรุณาตรวจสอบตำแหน่งและภาพล่าสุดด้วยแผนที่เฉพาะชื่อสถานที่',emptyLink:'เปิดแผนที่และรูปภาพ',caption:'ภาพสถานที่ที่ระบุตำแหน่งแล้ว',description:'ประวัติ สถาปัตยกรรม เส้นทางเดิน และคำแนะนำการเที่ยว'
};
const { messages } = await getI18n(Astro.url);
const canonical = `${siteConfig.domain}/${lang}/guides/${slug}/`;
const alternates = (['th','en','zh'] as const).map(l => ({ hreflang:l, href:`${siteConfig.domain}/${l}/guides/${slug}/` }));
const faq = [{q:ui.q1,a:ui.a1},{q:ui.q2,a:ui.a2},{q:ui.q3,a:ui.a3}];
const jsonLd = [
  { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:ui.home,item:`${siteConfig.domain}/${lang}/` },{ '@type':'ListItem',position:2,name:ui.guides,item:`${siteConfig.domain}/${lang}/#more-guides` },{ '@type':'ListItem',position:3,name:title,item:canonical }] },
  { '@context':'https://schema.org','@type':'Article',inLanguage:lang,headline:title,description:tagline,mainEntityOfPage:canonical },
  { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({ '@type':'Question',name:x.q,acceptedAnswer:{ '@type':'Answer',text:x.a } })) }
];
---
<BaseLayout lang={lang} messages={messages} title={`${title} | ${ui.home}`} description={`${tagline}${chinese ? '。' : ' — '}${ui.description}`} canonicalOverride={canonical} alternates={alternates} jsonLd={jsonLd}>
  <main class="bg-ivory text-ink min-h-screen"><article class="mx-auto max-w-5xl px-5 py-10 md:py-16">
    <nav class="text-sm text-ink/65 mb-8" aria-label="Breadcrumb"><a href={`/${lang}/`} class="hover:text-teak">{ui.home}</a> / <a href={`/${lang}/#more-guides`} class="hover:text-teak">{ui.guides}</a> / {title}</nav>
    <div class="grid gap-10 md:grid-cols-2 md:items-center"><div>
      <p class="text-sm uppercase tracking-widest text-teak">{ui.eyebrow}</p><h1 class="font-display text-4xl md:text-5xl leading-tight text-teak mt-3">{title}</h1><p class="text-xl text-ink/75 mt-5">{tagline}</p><p class="mt-5 leading-relaxed">{introduction}</p>
      <div class="mt-6 flex flex-wrap gap-3"><a class="rounded-full bg-teak text-white px-5 py-3 text-sm" href={mapUrl} target="_blank" rel="noopener noreferrer">{ui.map} ↗</a><a class="rounded-full border border-gold/50 px-5 py-3 text-sm" href={chinese ? '/zh/' : '/th/opening-hours/'}>{ui.entry}</a></div>
    </div>{images.length ? <figure><img src={images[0]} alt={`${subject} · ${ui.image}`} class="w-full aspect-[4/3] rounded-2xl object-cover" loading="lazy"/><figcaption class="text-xs text-ink/55 mt-2">{subject} · {ui.caption}</figcaption></figure> : <aside class="rounded-2xl border border-gold/30 bg-white/70 p-8"><h2 class="font-display text-2xl text-teak">{ui.emptyTitle}</h2><p class="mt-3">{ui.emptyText}</p><a class="inline-block text-teak underline mt-5" href={mapUrl} target="_blank" rel="noopener noreferrer">{ui.emptyLink} ↗</a></aside>}</div>
    <section class="mt-12 rounded-2xl border-l-4 border-gold bg-white/75 p-7"><h2 class="font-display text-3xl text-teak">{ui.about} {title}</h2><p class="mt-4 leading-relaxed">{management}</p><p class="mt-3 leading-relaxed">{introduction}</p></section>
    {images.length > 1 && <section class="mt-10"><h2 class="font-display text-2xl text-teak mb-4">{ui.views} · {title}</h2><div class="grid grid-cols-2 gap-4">{images.slice(1,5).map((src,i)=><img src={src} class="w-full aspect-[4/3] object-cover rounded-xl" loading="lazy" alt={`${subject} ${ui.image} ${i+2}`}/>)}</div></section>}
    <div class="grid gap-8 md:grid-cols-3 mt-14"><section class="rounded-2xl bg-white/70 border border-gold/20 p-6"><h2 class="font-display text-2xl text-teak">{ui.notice}</h2><p class="leading-relaxed mt-3">{highlights}</p></section><section class="rounded-2xl bg-white/70 border border-gold/20 p-6"><h2 class="font-display text-2xl text-teak">{ui.history}</h2><p class="leading-relaxed mt-3">{introduction}</p></section><section class="rounded-2xl bg-white/70 border border-gold/20 p-6"><h2 class="font-display text-2xl text-teak">{ui.tip}</h2><p class="leading-relaxed mt-3">{photo}</p></section></div>
    <section class="mt-14 border-t border-gold/25 pt-10"><h2 class="font-display text-3xl text-teak">{ui.story}</h2><p class="mt-4 leading-relaxed">{introduction}</p><p class="mt-3 leading-relaxed">{ui.storyNote}</p></section>
    <section class="mt-12"><h2 class="font-display text-3xl text-teak">{ui.info}</h2><dl class="mt-5 divide-y divide-gold/20 border-y border-gold/20"><div class="grid md:grid-cols-3 py-4 gap-2"><dt class="font-semibold">{ui.destination}</dt><dd class="md:col-span-2">{subject}</dd></div><div class="grid md:grid-cols-3 py-4 gap-2"><dt class="font-semibold">{ui.location}</dt><dd class="md:col-span-2">{area} · <a class="text-teak underline" href={mapUrl} target="_blank" rel="noopener noreferrer">{ui.navigation}</a></dd></div><div class="grid md:grid-cols-3 py-4 gap-2"><dt class="font-semibold">{ui.hours}</dt><dd class="md:col-span-2">{ui.hoursText}</dd></div><div class="grid md:grid-cols-3 py-4 gap-2"><dt class="font-semibold">{ui.dress}</dt><dd class="md:col-span-2">{ui.dressText}</dd></div><div class="grid md:grid-cols-3 py-4 gap-2"><dt class="font-semibold">{ui.transport}</dt><dd class="md:col-span-2">{ui.transportText} <a class="text-teak underline" href={chinese ? '/zh/' : '/th/'}>{ui.transportLink}</a></dd></div></dl></section>
    <section class="mt-12"><h2 class="font-display text-3xl text-teak">{ui.walk}</h2><ol class="mt-5 list-decimal pl-6 space-y-3 leading-relaxed"><li>{ui.step1}</li><li>{route}</li><li>{ui.step3}</li><li>{ui.step4}</li></ol></section>
    <section class="mt-12"><h2 class="font-display text-3xl text-teak">{ui.before}</h2><p class="mt-4 leading-relaxed">{ui.beforeText}</p></section>
    <section class="mt-12"><h2 class="font-display text-3xl text-teak">{ui.faq}</h2><div class="divide-y divide-gold/20 mt-4">{faq.map(x=><details class="py-4"><summary class="cursor-pointer font-semibold">{x.q}</summary><p class="mt-3 leading-relaxed">{x.a}</p></details>)}</div></section>
    <section class="mt-12 rounded-2xl bg-white/70 p-6"><h2 class="font-display text-2xl text-teak">{ui.sources}</h2><p class="mt-3 leading-relaxed">{ui.sourceText} <a class="text-teak underline" href="https://www.tourismthailand.org/Attraction/bang-pa-in-palace" target="_blank" rel="noopener noreferrer">Tourism Authority of Thailand</a>{chinese ? '、' : ', '}<a class="text-teak underline" href="https://go.ayutthaya.go.th/tourist-attraction/no-temple-touring/bang-pa-in-palace/" target="_blank" rel="noopener noreferrer">Go Ayutthaya</a>{chinese ? '、' : ', '}<a class="text-teak underline" href="https://www.thailandtourismdirectory.go.th/en/attraction/1446" target="_blank" rel="noopener noreferrer">Thailand Tourism Directory</a>{chinese ? '。' : '. '}{ui.sourceNote}</p>{place?.externalImages && <p class="mt-3 text-sm">{ui.imageSource} <a class="underline text-teak" href={rail ? 'https://th.trip.com/moments/detail/bang-pa-in-24523-16139428/' : `https://commons.wikimedia.org/w/index.php?search=${encodeURIComponent(subject)}&title=Special:MediaSearch&type=image`} target="_blank" rel="noopener noreferrer">{rail ? ui.railPhoto : ui.photoLink}</a></p>}</section>
    <section class="mt-12"><h2 class="font-display text-3xl text-teak">{ui.mapHeading}</h2><p class="mt-3">{ui.mapText}</p><a class="inline-block mt-5 rounded-full bg-teak text-white px-6 py-3" href={mapUrl} target="_blank" rel="noopener noreferrer">{ui.go} {subject} ↗</a></section>
    <section class="mt-12"><h2 class="font-display text-2xl text-teak">{ui.more}</h2><div class="mt-4 flex flex-wrap gap-3"><a href={`/${lang}/`} class="underline text-teak">{ui.overview}</a><a href={`/${lang}/guides/thai-chinese-european/`} class="underline text-teak">{ui.architecture}</a><a href={`/${lang}/guides/nearby-attractions/`} class="underline text-teak">{ui.nearby}</a><a href={`/${lang}/guides/photography-guide/`} class="underline text-teak">{ui.photography}</a></div></section>
  </article></main>
</BaseLayout>

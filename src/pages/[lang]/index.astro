---
import { languagesList } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Ecosystem from '../../components/Ecosystem.astro';
import History from '../../components/History.astro';
import Weather from '../../components/Weather.astro';
import StrictDressCode from '../../components/StrictDressCode.astro';
import TransportHub from '../../components/TransportHub.astro';
import SeasonalTable from '../../components/SeasonalTable.astro';
  import Guide from '../../components/Guide.astro';
  import AudienceRoutes from '../../components/AudienceRoutes.astro';
  import ClassicRoutes from '../../components/ClassicRoutes.astro';
  import Amenities from '../../components/Amenities.astro';
  import Responsibility from '../../components/Responsibility.astro';
  import Food from '../../components/Food.astro';
import Gallery from '../../components/Gallery.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
import MobileStickyCTA from '../../components/MobileStickyCTA.astro';
import { getI18n } from '../../i18n/ui';

export async function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = await getI18n(Astro.url);
---

<BaseLayout lang={lang} title={messages.meta.title} description={messages.meta.description} messages={messages}>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} />
    <About messages={messages} />
    <Ecosystem messages={messages} />
    <History messages={messages} />
    <Weather lang={lang} messages={messages} />
    <StrictDressCode lang={lang} messages={messages} />
    <TransportHub lang={lang} messages={messages} />
    <SeasonalTable lang={lang} messages={messages} />
    <Guide messages={messages} />
    <TopicLinks lang={lang} />
    <AudienceRoutes lang={lang} messages={messages} />
    <ClassicRoutes lang={lang} messages={messages} />
    <Amenities lang={lang} messages={messages} />
    <Responsibility lang={lang} messages={messages} />
    <Food messages={messages} />
    <Gallery messages={messages} />
    <section class="bg-teakDeep text-ivory py-10" aria-label={lang === 'zh' ? '站点资料' : lang === 'th' ? 'ข้อมูลเว็บไซต์' : 'Site information'}>
      <div class="max-w-5xl mx-auto px-5 grid gap-3 sm:grid-cols-3 text-center">
        {[
          { key: 'about', title: lang === 'zh' ? '关于本指南' : lang === 'th' ? 'เกี่ยวกับคู่มือ' : 'About this guide' },
          { key: 'reviews', title: lang === 'zh' ? '游客评价' : lang === 'th' ? 'รีวิวผู้มาเยือน' : 'Visitor reviews' },
          { key: 'sources', title: lang === 'zh' ? '资料来源与更正' : lang === 'th' ? 'แหล่งข้อมูลและการแก้ไข' : 'Sources and corrections' },
        ].map((link) => <a class="rounded-xl border border-gold/30 p-4 text-goldBright hover:bg-ivory/10 transition-colors" href={`/${lang}/site/${link.key}/`}>{link.title} ↗</a>)}
      </div>
    </section>
    <MapSection lang={lang} messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} />
  <MobileStickyCTA lang={lang} messages={messages} />
</BaseLayout>

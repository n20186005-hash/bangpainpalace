---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const cta = messages.mobileCta;
---

<div class="md:hidden fixed bottom-0 inset-x-0 z-50 border-t border-gold/30 bg-teakDeep/95 backdrop-blur-md pb-[env(safe-area-inset-bottom)]">
  <div class="grid grid-cols-2 gap-0">
    <a
      href={siteConfig.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 py-3.5 text-sm font-medium text-ivory border-r border-gold/20 active:bg-teak/60"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      {cta.map}
    </a>
    <a
      href={`tel:${siteConfig.phone}`}
      class="flex items-center justify-center gap-2 py-3.5 text-sm font-medium text-goldBright active:bg-teak/60"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      {cta.call}
    </a>
  </div>
</div>

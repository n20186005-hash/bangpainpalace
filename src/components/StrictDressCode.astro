---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const d = messages.dressCode;
---

<section id="dress-code" class="py-20 bg-ivory text-ink">
  <div class="max-w-5xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{d.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2 leading-tight">{d.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80 leading-relaxed">{d.intro}</p>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      <!-- 可以 -->
      <div class="rounded-2xl border border-emerald-300 bg-emerald-50/80 p-6">
        <h3 class="font-display text-xl text-emerald-800 font-semibold flex items-center gap-2">
          <span class="text-emerald-600">✓</span> {d.allowedTitle}
        </h3>
        <ul class="mt-4 space-y-2.5">
          {d.allowed.map((it: string) => (
            <li class="flex gap-2.5 text-sm text-emerald-900/90 leading-relaxed">
              <span class="text-emerald-500 mt-0.5 flex-shrink-0">·</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 禁止 -->
      <div class="rounded-2xl border border-red-300 bg-red-50/80 p-6">
        <h3 class="font-display text-xl text-red-800 font-semibold flex items-center gap-2">
          <span class="text-red-600">✕</span> {d.forbiddenTitle}
        </h3>
        <ul class="mt-4 space-y-2.5">
          {d.forbidden.map((it: string) => (
            <li class="flex gap-2.5 text-sm text-red-900/90 leading-relaxed">
              <span class="text-red-500 mt-0.5 flex-shrink-0">·</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- 现场补救提示 -->
    <div class="mt-8 rounded-2xl border border-gold/40 bg-teak/5 p-6">
      <h3 class="font-display text-xl text-teak font-semibold">{d.onSiteTitle}</h3>
      <ul class="mt-4 space-y-2.5">
        {d.onSite.map((it: string) => (
          <li class="flex gap-2.5 text-sm text-ink/80 leading-relaxed">
            <span class="text-gold mt-0.5 flex-shrink-0">·</span>
            <span>{it}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-6 text-xs text-ink/55 italic leading-relaxed">{d.footnote}</p>
  </div>
</section>

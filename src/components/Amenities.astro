---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const a = messages.amenities;
---

<section id="amenities" class="bg-sand py-24 relative">
  <div class="max-w-7xl mx-auto px-5">
    <div class="text-center max-w-3xl mx-auto">
      <p class="uppercase tracking-[0.2em] text-xs text-teak/70">{a.label}</p>
      <div class="ornament mt-4 mx-auto max-w-md"></div>
      <h2 class="font-display text-3xl md:text-4xl text-teak mt-6 leading-tight">{a.heading}</h2>
      <p class="mt-5 text-ink/70 leading-relaxed">{a.intro}</p>
    </div>

    <div class="mt-16 grid lg:grid-cols-5 gap-8">
      <!-- 园内服务 -->
      <div class="lg:col-span-2 bg-ivory rounded-2xl border border-gold/25 p-7 shadow-sm">
        <h3 class="font-display text-2xl text-burgundy flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center">🏛️</span>
          {a.onSite.title}
        </h3>
        <div class="mt-6 space-y-4">
          {a.onSite.items.map((it: { k: string; v: string }) => (
            <div class="border-b border-dashed border-gold/20 pb-4 last:border-0">
              <p class="font-semibold text-sm text-teak">{it.k}</p>
              <p class="mt-1 text-sm text-ink/75 leading-relaxed">{it.v}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 周边设施 -->
      <div class="lg:col-span-3 grid sm:grid-cols-2 gap-4 content-start">
        <h3 class="sm:col-span-2 font-display text-2xl text-burgundy flex items-center gap-3 px-2">
          <span class="w-10 h-10 rounded-full bg-teak/10 flex items-center justify-center">🛣️</span>
          {a.nearby.title}
        </h3>
        {a.nearby.categories.map((cat: any) => (
          <article class="bg-white/80 rounded-xl border border-gold/15 p-5 hover:shadow-md hover:-translate-y-0.5 transition-all">
            <h4 class="font-display text-lg text-teak border-l-4 border-gold pl-3">
              {cat.name}
            </h4>
            <p class="mt-3 text-sm text-ink/75 leading-relaxed">
              {cat.desc}
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

---
import type { Lang } from '../i18n/ui';
import { fetchWeather, fmtTime, buildSuggestions, classifyCondition, windLevel } from '../lib/weather';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const w = messages.weather;

let weather = null;
try {
  weather = await fetchWeather();
} catch (_e) {
  weather = null;
}

function weekdayLabel(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  const th = ['อา.', 'จ.', 'อ.', 'พ.', 'พฤ.', 'ศ.', 'ส.'];
  const zh = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  const en = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const map = { th, zh, en } as const;
  return map[lang as 'th' | 'zh' | 'en'][d.getDay()];
}

function dateShort(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  if (lang === 'th') return `${d.getDate()}/${d.getMonth() + 1}`;
  if (lang === 'zh') return `${d.getMonth() + 1}月${d.getDate()}日`;
  const m = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${m[d.getMonth()]} ${d.getDate()}`;
}

function humidityBucket(h: number): 'dry' | 'normal' | 'sticky' | 'swamp' {
  if (h < 45) return 'dry';
  if (h < 65) return 'normal';
  if (h < 80) return 'sticky';
  return 'swamp';
}

function uvBucket(uv: number): 'low' | 'mod' | 'high' | 'vhigh' {
  if (uv < 3) return 'low';
  if (uv < 6) return 'mod';
  if (uv < 8) return 'high';
  return 'vhigh';
}

function conditionKeyOf(weatherCode: number, precipSum: number): string {
  const cc = classifyCondition(weatherCode, precipSum);
  if (cc.thunder) return 'storm';
  if (cc.fog) return 'fog';
  if (cc.kind === 'clear') return 'clear';
  if (cc.kind === 'cloudy') return 'cloudy';
  if (cc.kind === 'drizzle') return 'drizzle';
  if (cc.kind === 'storm') return 'storm';
  if (cc.rainIntensity === 'light') return 'light_rain';
  if (cc.rainIntensity === 'medium') return 'medium_rain';
  if (cc.rainIntensity === 'heavy') return 'heavy_rain';
  return 'cloudy';
}

const ICON_MAP: Record<string, string> = {
  clear: '☀️',
  cloudy: '☁️',
  drizzle: '🌦️',
  light_rain: '🌧️',
  medium_rain: '🌧️',
  heavy_rain: '🌧️',
  storm: '⛈️',
  fog: '🌫️',
};

function iconOf(key: string): string {
  return ICON_MAP[key] || '🌤️';
}

const suggestions = weather ? buildSuggestions(weather.current, weather.daily[0]) : null;
---

<section id="weather" class="bg-teakDeep text-ivory py-24 relative overflow-hidden">
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute top-0 left-1/3 w-[600px] h-[600px] rounded-full bg-gold/20 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full bg-burgundy/20 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-5 relative">
    <div class="text-center max-w-3xl mx-auto">
      <p class="uppercase tracking-[0.2em] text-xs text-gold/80">{w.label}</p>
      <div class="ornament mt-4 mx-auto max-w-md"></div>
      <h2 class="font-display text-3xl md:text-4xl text-goldBright mt-6 leading-tight">{w.heading}</h2>
      <p class="mt-5 text-ivory/70 leading-relaxed">{w.intro}</p>
    </div>

    {weather && suggestions ? (
      <div class="mt-16 space-y-8">
        {suggestions.warning && (
          <div class="rounded-2xl border-2 border-rose-400/60 bg-rose-950/60 backdrop-blur px-6 py-5">
            <p class="text-rose-100 leading-relaxed text-[15px]">
              {w.warning[suggestions.warning]}
            </p>
          </div>
        )}

        <div class="grid lg:grid-cols-12 gap-8">
          <!-- 左侧当前天气卡 -->
          <div class="lg:col-span-4 space-y-5">
            <div class="bg-teak/60 border border-gold/20 rounded-2xl p-7 backdrop-blur">
              <p class="uppercase tracking-widest text-xs text-gold/80">{w.now}</p>
              <div class="mt-5 flex items-end gap-5">
                <div>
                  <p class="font-display text-7xl text-goldBright leading-none">{weather.current.temp}°</p>
                  <p class="mt-3 text-sm text-ivory/70">
                    {w.feelsLike} <span class="text-goldBright font-semibold">{weather.current.feelsLike}°</span>
                    <span class="mx-2 text-ivory/30">·</span>
                    {w.humidity} <span class="text-ivory/90">{w.humidityHuman[humidityBucket(weather.current.humidity)]}</span>
                  </p>
                  <p class="mt-2 text-xs text-ivory/50">
                    {w.retrieved} {fmtTime(new Date(weather.retrievedAt))}
                  </p>
                </div>
                <div class="ml-auto text-right">
                  <p class="text-6xl">{suggestions.icon}</p>
                  <p class="mt-2 text-sm text-goldBright/90 font-medium">
                    {w.condition[suggestions.conditionKey]}
                  </p>
                </div>
              </div>

              <div class="mt-7 grid grid-cols-3 gap-2 text-center">
                <div class="rounded-xl border border-gold/15 bg-teakDeep/40 py-3">
                  <p class="text-xs text-ivory/50">💧 {w.columns.rain}</p>
                  <p class="mt-1 text-lg font-semibold text-goldBright">{weather.daily[0].precipitationProbMax}%</p>
                </div>
                <div class="rounded-xl border border-gold/15 bg-teakDeep/40 py-3">
                  <p class="text-xs text-ivory/50">💨 {w.wind}</p>
                  <p class="mt-1 text-lg font-semibold text-goldBright">{weather.current.windKmh}<span class="text-xs text-ivory/50 ml-0.5">km/h</span></p>
                </div>
                <div class="rounded-xl border border-gold/15 bg-teakDeep/40 py-3">
                  <p class="text-xs text-ivory/50">☀ {w.columns.uv}</p>
                  <p class="mt-1 text-lg font-semibold text-goldBright">{w.uvLabel[uvBucket(weather.daily[0].uvMax)]}</p>
                </div>
              </div>
            </div>

            <!-- 三大类标签分组（左侧堆叠，小屏自适应） -->
            {suggestions.outfit.length > 0 && (
              <div class="bg-teak/60 border border-gold/20 rounded-2xl p-6 backdrop-blur">
                <h3 class="font-display text-lg text-goldBright">{w.bucketTitles.outfit}</h3>
                <ul class="mt-4 space-y-2.5">
                  {suggestions.outfit.map((k: string) => (
                    <li class="flex gap-2.5 text-sm text-ivory/85 leading-relaxed">
                      <span class="text-gold/80 mt-0.5 flex-shrink-0">·</span>
                      <span>{w.advice[k]}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- 右侧 中间分组 + 7 日预报 -->
          <div class="lg:col-span-8 space-y-5">
            <div class="grid md:grid-cols-2 gap-5">
              {suggestions.plan.length > 0 && (
                <div class="bg-teak/60 border border-gold/20 rounded-2xl p-6 backdrop-blur">
                  <h3 class="font-display text-lg text-goldBright">{w.bucketTitles.plan}</h3>
                  <ul class="mt-4 space-y-2.5">
                    {suggestions.plan.map((k: string) => (
                      <li class="flex gap-2.5 text-sm text-ivory/85 leading-relaxed">
                        <span class="text-gold/80 mt-0.5 flex-shrink-0">·</span>
                        <span>{w.advice[k]}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {suggestions.gear.length > 0 && (
                <div class="bg-teak/60 border border-gold/20 rounded-2xl p-6 backdrop-blur">
                  <h3 class="font-display text-lg text-goldBright">{w.bucketTitles.gear}</h3>
                  <ul class="mt-4 space-y-2.5">
                    {suggestions.gear.map((k: string) => (
                      <li class="flex gap-2.5 text-sm text-ivory/85 leading-relaxed">
                        <span class="text-gold/80 mt-0.5 flex-shrink-0">·</span>
                        <span>{w.advice[k]}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <!-- 7 日预报 -->
            <div class="bg-teak/40 border border-gold/15 rounded-2xl p-6 backdrop-blur">
              <h3 class="font-display text-lg text-goldBright">{w.forecast}</h3>
              <div class="mt-5 grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
                {weather.daily.slice(0, 7).map((d: any, idx: number) => {
                  const key = conditionKeyOf(d.weatherCode, d.precipitationSum);
                  const today = idx === 0;
                  const uv = uvBucket(d.uvMax);
                  const windLv = windLevel(d.windMaxKmh);
                  const s = buildSuggestions(
                    { temp: Math.round((d.tempMax + d.tempMin) / 2), feelsLike: Math.round((d.tempMax + d.tempMin) / 2), humidity: 65, windKmh: d.windMaxKmh, conditionCode: d.weatherCode },
                    d,
                  );
                  // 从 plan 或 outfit 选第一条作为 1 行提示
                  const shortTip = s.plan[0]
                    ? w.advice[s.plan[0]]
                    : s.outfit[0]
                      ? w.advice[s.outfit[0]]
                      : s.warning
                        ? w.warning[s.warning]
                        : w.noUmbrellaDays;
                  return (
                    <div class={`rounded-xl p-4 border ${today ? 'border-goldBright/50 bg-teak/80' : 'border-gold/15 bg-teakDeep/40'}`}>
                      <div class="flex items-center justify-between">
                        <div>
                          <p class="font-display text-base text-ivory">
                            {weekdayLabel(d.date)}
                            {today && <span class="ml-1.5 text-[10px] px-1.5 py-0.5 rounded bg-goldBright/20 text-goldBright align-middle">{lang === 'zh' ? '今天' : lang === 'th' ? 'วันนี้' : 'Today'}</span>}
                          </p>
                          <p class="text-xs text-ivory/50">{dateShort(d.date)}</p>
                          <p class="mt-1.5 text-sm">
                            <span class="text-goldBright font-semibold">{d.tempMax}°</span>
                            <span class="text-ivory/50"> / {d.tempMin}°</span>
                          </p>
                        </div>
                        <p class="text-3xl">{iconOf(key)}</p>
                      </div>
                      <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-ivory/60">
                        <span>💧 {d.precipitationProbMax}%</span>
                        <span>☀ {w.uvLabel[uv]}</span>
                        {windLv >= 5 && <span class="text-amber-300/80">💨 {windLv >= 7 ? (lang === 'zh' ? '强风' : lang === 'th' ? 'ลมแรง' : 'Gale') : (lang === 'zh' ? '风大' : lang === 'th' ? 'ลมค่อนข้างแรง' : 'Windy')}</span>}
                      </div>
                      <p class="mt-3 text-xs text-ivory/80 leading-relaxed line-clamp-3">
                        {shortTip}
                      </p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="mt-16 text-center text-ivory/60">
        <p class="font-display text-2xl text-goldBright/80">🔄</p>
        <p class="mt-3 text-sm">{w.intro}</p>
      </div>
    )}

    <p class="mt-10 text-center text-xs text-ivory/40">{w.noUmbrellaDays}</p>
  </div>
</section>

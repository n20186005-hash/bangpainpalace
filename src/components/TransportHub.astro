---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const t = messages.transport;
---

<section id="getting-there" class="py-20 bg-teakDeep/95 text-ivory relative overflow-hidden">
  <div class="absolute inset-0 opacity-15 pointer-events-none">
    <div class="absolute top-10 -left-20 w-[500px] h-[500px] rounded-full bg-gold/30 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] rounded-full bg-burgundy/30 blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-5 relative">
    <p class="font-hand text-gold text-xl md:text-2xl">{t.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-goldBright mt-2 leading-tight">{t.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/75 leading-relaxed">{t.intro}</p>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {t.modes.map((m: any, idx: number) => (
        <div class="rounded-2xl border border-gold/20 bg-teak/60 backdrop-blur p-5 flex flex-col">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-display text-lg text-goldBright font-semibold">{m.title}</h3>
            <span class="text-xs px-2 py-0.5 rounded-full bg-gold/15 text-gold/90">{m.tag}</span>
          </div>
          <div class="text-xs text-ivory/55 mb-2">
            {t.durationLabel}: <span class="text-ivory/90 font-medium">{m.duration}</span>
          </div>
          {m.price && (
            <div class="text-xs text-ivory/55 mb-3">
              {t.priceLabel}: <span class="text-ivory/90 font-medium">{m.price}</span>
            </div>
          )}
          <ul class="mt-1 space-y-2">
            {m.steps.map((s: string) => (
              <li class="flex gap-2 text-sm text-ivory/80 leading-relaxed">
                <span class="text-gold/70 mt-0.5 flex-shrink-0">·</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {t.arrival && (
      <div class="mt-8 rounded-2xl border border-rose-400/30 bg-rose-950/40 p-5">
        <h3 class="font-display text-lg text-rose-200 font-semibold">{t.arrival.title}</h3>
        <ul class="mt-3 space-y-2">
          {t.arrival.items.map((it: string) => (
            <li class="flex gap-2 text-sm text-rose-50/85 leading-relaxed">
              <span class="text-rose-300 mt-0.5 flex-shrink-0">·</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {t.footnote && (
      <p class="mt-6 text-xs text-ivory/45 italic leading-relaxed">{t.footnote}</p>
    )}
  </div>
</section>
